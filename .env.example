# Backend configuration. Every value has a working default; set only what you
# need to change. Copy to .env for local use, or paste into your host's
# environment variable settings.

# Comma-separated origins allowed to call the API from a browser. Required
# only when the frontend is deployed separately from the backend.
ALLOWED_ORIGINS=http://localhost:5173

# Directory of built frontend files to serve from the same process. Set by the
# Dockerfile; leave empty when running the API and the Vite dev server apart.
STATIC_DIR=

# Upload limits.
MAX_UPLOAD_BYTES=16777216
MAX_DURATION_SECONDS=120

# How long a decoded clip stays in memory, and how much memory the store may
# use in total before the oldest clips are evicted.
CLIP_TTL_SECONDS=1800
MAX_CLIPS=48
MAX_STORE_BYTES=536870912
MAX_RENDERS_PER_CLIP=8

# Per-client rate limits, as a request count over a window in seconds.
UPLOAD_RATE=12
UPLOAD_WINDOW_SECONDS=300
PROCESS_RATE=180
PROCESS_WINDOW_SECONDS=60

# Hard ceiling on one processing job.
PROCESSING_TIMEOUT_SECONDS=30

# Concurrent processing jobs. Each holds a full spectrogram in memory while it
# runs, so this multiplies peak memory directly. Keep it at 1 on a 512 MB host.
DSP_WORKERS=2


# Frontend build-time configuration (frontend/.env).
# Leave unset for a same-origin deployment such as the Docker image. Set it to
# the backend's public URL when the frontend is hosted separately.
# VITE_API_BASE_URL=https://your-backend-host.example.com
